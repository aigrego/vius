# 数据库（PostgreSQL）
# connection_limit/pool_timeout：Prisma 连接池参数。默认 limit=5、timeout=10s，
# 在「定时任务 + API 共用单进程池 + 高延迟链路（如 Neon 跨区域）」下容易耗尽，
# 建议显式调大（按部署进程数评估，单进程 15~20 足够）
DATABASE_URL=postgres://postgres:postgres@livebook:5433/vius?connection_limit=15&pool_timeout=30

# 会话密钥（openssl rand -hex 32）
SESSION_SECRET=

# 种子管理员密码（npm run db:seed 使用，默认 admin123）
SEED_ADMIN_PASSWORD=

# 手动触发同步接口 Bearer 密钥（POST /api/ashare/sync）
CRON_SECRET=

# 飞书 webhook 告警推送（自定义机器人地址）
FEISHU_WEBHOOK_URL=

# 飞书/Lark OAuth（企业自建应用；未配置时登录页隐藏三方登录按钮）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_REDIRECT_URI=http://localhost:3000/api/auth/lark/callback

# GitHub OAuth（OAuth App，创建地址 https://github.com/settings/developers；
# 回调路径 /api/auth/github/callback；未配置时登录页隐藏 GitHub 按钮）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
