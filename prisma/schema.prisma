generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户（账号密码或 OAuth 登录：飞书/Lark/GitHub）
model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String      @map("password_hash") // '!oauth' 表示未设密码、仅 OAuth 登录
  name         String?
  role         String      @default("member") // admin / member
  larkUnionId  String?     @unique @map("lark_union_id")
  githubId     String?     @unique @map("github_id") // GitHub 数字 id 转字符串
  avatarUrl    String?     @map("avatar_url")
  createdAt    DateTime    @default(now()) @map("created_at")
  emails       UserEmail[]
  watchlists   Watchlist[]
  positions    Position[]

  @@map("users")
}

// 用户邮箱（多邮箱：任一邮箱可作为登录账号；source 标记来源，决定「Lark 验证」等 badge）
model UserEmail {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  email     String   @unique // 全局唯一，小写存储
  isPrimary Boolean  @default(false) @map("is_primary")
  source    String   @default("manual") // manual / feishu / lark / github
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_emails")
}

// 邀请（OAuth 注册白名单：三方登录邮箱须命中 pending 邀请才放行；accepted 留档审计）
model Invitation {
  id         String    @id @default(uuid())
  email      String    @unique // 小写存储
  status     String    @default("pending") // pending / accepted
  invitedBy  String?   @map("invited_by") // 操作人 admin uid（松引用，无外键）
  userId     String?   @map("user_id") // 接受后回填（建号/绑定的用户）
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  @@map("invitations")
}

// 股票字典（全系统主线：A股/港股/指数/ETF；code 为带市场前缀的 fullCode，如 SH600519/HK00700）
model StockDict {
  code              String       @id @db.VarChar(20) // fullCode：SH600519/SZ000001/BJ430047/HK00700
  market            String       @db.VarChar(10) // SH/SZ/BJ/HK
  name              String       @db.VarChar(100)
  formerNames       String?      @map("former_names") // 曾用名，逗号分隔
  type              String       @default("stock") @db.VarChar(10) // stock/index/etf
  marketCap         Float?       @map("market_cap") // 总市值（元）
  floatMarketCap    Float?       @map("float_market_cap") // 流通市值（元）
  mainBusiness      Json?        @map("main_business") // 主营业务
  profitComposition Json?        @map("profit_composition") // 盈利构成
  financials        Json? // 常用财务指标快照（PE/PB/ROE 等）
  listedDate        DateTime?    @map("listed_date") @db.Date
  isActive          Boolean      @default(true) @map("is_active") // 退市置 false
  fundamentalsAt    DateTime?    @map("fundamentals_at") // 基本面最近回填时间（慢速回填调度依据）
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  trades            StockTrade[]
  newsStocks        NewsStock[]
  plateStocks       PlateStock[]
  watchlists        Watchlist[]
  positions         Position[]
  signals           StockSignal[]

  @@map("stock_dict")
}

// 股票交易（每股每日一条；盘中由 sync-snapshot 更新当日行，收盘后 sync-daily 覆盖）
model StockTrade {
  id        Int       @id @default(autoincrement())
  stockCode String    @map("stock_code") @db.VarChar(20)
  date      DateTime  @db.Date
  open      Float? // 今开
  current   Float? // 现价；收盘后=收盘价
  prevOpen  Float?    @map("prev_open") // 昨日开盘
  prevClose Float?    @map("prev_close") // 昨日收盘
  high      Float? // 最高
  low       Float? // 最低
  changePct Float?    @map("change_pct") // 涨跌幅（%）
  amplitude Float? // 振幅 = (high-low)/prevClose*100
  volume    Float? // 成交量（手，沿用东财约定）
  amount    Float? // 成交额（元）
  turnover  Float? // 换手率（腾讯兜底源为 null）
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  stock     StockDict @relation(fields: [stockCode], references: [code])

  @@unique([stockCode, date])
  @@index([date])
  @@map("stock_trade")
}

// 自选股/持仓（按用户隔离：每人一个独立股票池；名称/市场/类型从 stock_dict 关联获得）
model Watchlist {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id")
  stockCode  String    @map("stock_code") @db.VarChar(20) // fullCode，关联 stock_dict
  cost       Decimal   @default(0) @db.Decimal(10, 4)
  markPrice  Decimal?  @map("mark_price") @db.Decimal(10, 4) // 关注时价格（算「关注后涨跌幅」用，存量为 null 时懒回填）
  alertsJson String    @map("alerts_json")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock      StockDict @relation(fields: [stockCode], references: [code])

  @@unique([userId, stockCode])
  @@map("watchlist")
}

// 持仓记录（按用户隔离；同一股票允许多条买入价/数量不同的持仓记录）
model Position {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  stockCode String    @map("stock_code") @db.VarChar(20) // fullCode，关联 stock_dict
  price     Decimal   @db.Decimal(10, 4) // 买入价
  quantity  Int // 买入数量（股）
  status    String    @default("holding") @db.VarChar(10) // holding 持仓中 / sold 已卖出
  sellPrice Decimal?  @map("sell_price") @db.Decimal(10, 4) // 卖出价（sold 时必填）
  soldAt    DateTime? @map("sold_at") @db.Timestamp(0) // 卖出时间
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock     StockDict @relation(fields: [stockCode], references: [code])

  @@index([userId, stockCode])
  @@index([userId, status])
  @@map("position")
}

// 审计日志
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(50)
  code      String?  @db.VarChar(20)
  details   String?
  agentId   String?  @map("agent_id") @db.VarChar(100)
  timestamp DateTime @default(now()) @db.Timestamp(0)

  @@index([timestamp])
  @@map("audit_log")
}

// 告警历史（userId 为归属用户；存量老数据为 null，仅全体清理时可见）
model AlertHistory {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id")
  code           String   @db.VarChar(20)
  alertType      String   @map("alert_type") @db.VarChar(50)
  severity       String   @db.VarChar(20)
  message        String
  currentValue   Decimal? @map("current_value") @db.Decimal(10, 4)
  thresholdValue Decimal? @map("threshold_value") @db.Decimal(10, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([code, alertType, createdAt])
  @@index([userId, createdAt])
  @@map("alert_history")
}

// 分析信号（底部放量/顶部放量等）
model StockSignal {
  id        Int       @id @default(autoincrement())
  stockCode String    @map("stock_code") @db.VarChar(20) // fullCode，关联 stock_dict
  date      DateTime  @db.Date
  type      String    @db.VarChar(30) // bottom_volume / top_volume
  detail    String? // JSON：量比、位置分位等
  stock     StockDict @relation(fields: [stockCode], references: [code])

  @@unique([stockCode, date, type])
  @@index([date, type])
  @@map("stock_signal")
}

// 资讯快讯（定时抓取落库；关联的股票走 news_stock 关联表，可多对多）
model NewsFlash {
  id          Int         @id @default(autoincrement())
  source      String      @db.VarChar(20) // wallstcn / xuangubao
  externalId  String      @map("external_id") @db.VarChar(50)
  title       String?     @db.VarChar(500)
  content     String
  publishedAt DateTime    @map("published_at")
  newsStocks  NewsStock[]

  @@unique([source, externalId])
  @@index([publishedAt])
  @@map("news_flash")
}

// 资讯-股票关联（多对多；keyword 为命中词留痕）
model NewsStock {
  id        Int       @id @default(autoincrement())
  newsId    Int       @map("news_id")
  stockCode String    @map("stock_code") @db.VarChar(20)
  keyword   String?   @db.VarChar(100)
  news      NewsFlash @relation(fields: [newsId], references: [id], onDelete: Cascade)
  stock     StockDict @relation(fields: [stockCode], references: [code])

  @@unique([newsId, stockCode])
  @@index([stockCode])
  @@map("news_stock")
}

// 板块（行业/题材；code = 源前缀:原始id，如 xgb:886001、qq:pt0124）
model Plate {
  code      String       @id @db.VarChar(40)
  name      String       @db.VarChar(100)
  kind      String       @db.VarChar(10) // industry / concept
  source    String       @db.VarChar(10) // xgb / qq
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)
  stocks    PlateStock[]

  @@map("plate")
}

// 板块成分股（关联 stock_dict，点开板块看成分股用）
model PlateStock {
  plateCode String    @map("plate_code") @db.VarChar(40)
  stockCode String    @map("stock_code") @db.VarChar(20)
  plate     Plate     @relation(fields: [plateCode], references: [code], onDelete: Cascade)
  stock     StockDict @relation(fields: [stockCode], references: [code])

  @@id([plateCode, stockCode])
  @@map("plate_stock")
}

// 资讯数据源配置（key 标识解析器；调度走全局 sync-news 任务轮询启用源）
model NewsSource {
  id             Int       @id @default(autoincrement())
  key            String    @unique @db.VarChar(20) // wallstcn / xuangubao
  name           String    @db.VarChar(50)
  url            String?   @db.VarChar(255) // 缺省用代码内置地址
  params         String?   @db.VarChar(255) // 源特定参数（如选股宝 subj_ids）
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamp(0)
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(10) // success / failed
  lastSyncCount  Int?      @map("last_sync_count")
  description    String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("news_source")
}

// 实时行情数据源（key 标识解析器：sina / tencent / eastmoney；fetchRealtimeQuotes 按 sort 升序只循环启用源）
model RealtimeSource {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(20) // sina / tencent / eastmoney
  name        String   @db.VarChar(50)
  sort        Int      @default(0) // 降级顺序，越小越优先
  enabled     Boolean  @default(true)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("realtime_source")
}

// 行情总览三排卡片缓存（indices 为全局 userId='*'，positions/watchlist 按用户隔离）
model OverviewCache {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  kind      String   @db.VarChar(20) // indices / positions / watchlist
  payload   String   @db.Text // JSON
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([userId, kind])
  @@map("overview_cache")
}

// 定时任务 cron 覆盖配置（仅被修改过的任务才有行，未覆盖时用代码注册表默认值）
model CronJob {
  id        String   @id // 对应 scheduler JOBS 注册表 id
  cron      String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("cron_job")
}

// 定时任务运行记录
model CronRun {
  id         Int       @id @default(autoincrement())
  jobId      String    @map("job_id") @db.VarChar(50)
  trigger    String    @db.VarChar(10) // auto / manual
  status     String    @db.VarChar(10) // running / success / failed
  message    String?   @db.Text
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamp(0)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(0)

  @@index([jobId, startedAt])
  @@map("cron_run")
}

// 龙虎榜个股上榜记录（每日收盘后同步；当日覆盖式写入，故无唯一约束）
model LhbStock {
  id         Int      @id @default(autoincrement())
  code       String   @db.VarChar(10)
  name       String   @db.VarChar(20)
  market     String   @db.VarChar(4) // sh / sz / bj
  date       DateTime @db.Date
  closePrice Float    @map("close_price")
  changePct  Float    @map("change_pct")
  amount     Float // 当日总成交额（元）
  reason     String   @db.VarChar(200) // 上榜原因
  changeType String   @map("change_type") @db.VarChar(30)
  tradeId    String   @map("trade_id") @db.VarChar(20) // 关联席位明细
  buyAmt     Float    @map("buy_amt")
  sellAmt    Float    @map("sell_amt")
  netAmt     Float    @map("net_amt") // 龙虎榜净买入

  @@index([date, market])
  @@map("lhb_stock")
}

// 龙虎榜席位明细（买入前五 / 卖出前五）
model LhbSeat {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(10)
  date      DateTime @db.Date
  tradeId   String   @map("trade_id") @db.VarChar(20)
  direction String   @db.VarChar(4) // buy / sell
  rank      Int // 1-5
  deptName  String   @map("dept_name") @db.VarChar(100)
  buy       Float
  sell      Float
  net       Float

  @@index([code, date])
  @@index([date])
  @@map("lhb_seat")
}

// 龙虎榜数据源配置（cron 字段仅保存展示，实际调度走全局 sync-lhb 任务）
model LhbSource {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(50)
  type           String    @default("api") @db.VarChar(10) // api（预留其他类型）
  url            String?   @db.VarChar(255)
  apiKey         String?   @map("api_key") @db.VarChar(255)
  cron           String?   @db.VarChar(50)
  description    String?   @db.VarChar(255)
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamp(0)
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(10) // success / failed
  lastSyncCount  Int?      @map("last_sync_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("lhb_source")
}

// 角色（users.role 存角色 key；admin/member 为内置角色，key 不可改、不可删）
model Role {
  id        String                @id @default(uuid())
  key       String                @unique // admin / member / 自定义（小写字母开头）
  name      String // 显示名：管理员 / VIP用户
  builtin   Boolean               @default(false)
  createdAt DateTime              @default(now()) @map("created_at")
  perms     RoleRoutePermission[]

  @@map("roles")
}

// 角色-路由权限（按治理路由逐条配置 rw/ro/hidden；admin 恒全 rw 不查此表）
model RoleRoutePermission {
  id     String @id @default(uuid())
  roleId String @map("role_id")
  route  String
  level  String // rw / ro / hidden
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, route])
  @@map("role_route_permissions")
}

// 板块行情缓存（行业/题材/涨幅榜/跌幅榜，sync-plates 定时任务预热，页面只读库）
model PlateCache {
  kind      String   @id @db.VarChar(20) // qq_hy / qq_gn / xgb_rise / xgb_fall
  payload   String   @db.Text // JSON（QQ 为上游原始响应，选股宝为整形后的板块数组）
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("plate_cache")
}
