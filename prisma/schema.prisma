generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户（飞书 OAuth 或账号密码登录）
model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String      @map("password_hash") // '!oauth' 表示未设密码、仅 OAuth 登录
  name         String?
  role         String      @default("member") // admin / member
  larkUnionId  String?     @unique @map("lark_union_id")
  avatarUrl    String?     @map("avatar_url")
  createdAt    DateTime    @default(now()) @map("created_at")
  emails       UserEmail[]
  watchlists   Watchlist[]
  positions    Position[]

  @@map("users")
}

// 用户邮箱（多邮箱：任一邮箱可作为登录账号；source 标记来源，决定「Lark 验证」等 badge）
model UserEmail {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  email     String   @unique // 全局唯一，小写存储
  isPrimary Boolean  @default(false) @map("is_primary")
  source    String   @default("manual") // manual / feishu / lark
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_emails")
}

enum StockSource {
  SS
  SZ
}

enum StockType {
  ZS
  AG
}

// 指数/股票清单（行情总览页用）
model Stock {
  id     Int         @id @default(autoincrement())
  code   String      @unique @db.VarChar(50)
  source StockSource
  type   StockType
}

// 自选股/持仓（按用户隔离：每人一个独立股票池）
model Watchlist {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  code       String   @db.VarChar(20)
  name       String   @db.VarChar(100)
  market     String   @db.VarChar(10)
  type       String   @default("individual") @db.VarChar(20)
  cost       Decimal  @default(0) @db.Decimal(10, 4)
  markPrice  Decimal? @map("mark_price") @db.Decimal(10, 4) // 关注时价格（算「关注后涨跌幅」用，存量为 null 时懒回填）
  alertsJson String   @map("alerts_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("watchlist")
}

// 持仓记录（按用户隔离；同一股票允许多条买入价/数量不同的持仓记录）
model Position {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(100)
  market    String   @db.VarChar(10)
  price     Decimal  @db.Decimal(10, 4) // 买入价
  quantity  Int // 买入数量（股）
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
  @@map("position")
}

// 审计日志
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(50)
  code      String?  @db.VarChar(20)
  details   String?
  agentId   String?  @map("agent_id") @db.VarChar(100)
  timestamp DateTime @default(now()) @db.Timestamp(0)

  @@index([timestamp])
  @@map("audit_log")
}

// 告警历史（userId 为归属用户；存量老数据为 null，仅全体清理时可见）
model AlertHistory {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id")
  code           String   @db.VarChar(20)
  alertType      String   @map("alert_type") @db.VarChar(50)
  severity       String   @db.VarChar(20)
  message        String
  currentValue   Decimal? @map("current_value") @db.Decimal(10, 4)
  thresholdValue Decimal? @map("threshold_value") @db.Decimal(10, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([code, alertType, createdAt])
  @@index([userId, createdAt])
  @@map("alert_history")
}

// A股股票清单（每日同步自东方财富）
model StockBasic {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(10)
  name       String    @db.VarChar(50)
  market     String    @db.VarChar(10) // sh/sz/bj
  listedDate DateTime? @map("listed_date")
  isActive   Boolean   @default(true) @map("is_active") // 退市置 false
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("stock_basic")
}

// A股日线行情（每日收盘后同步）
model StockDaily {
  id        Int      @id @default(autoincrement())
  code      String   @db.VarChar(10)
  date      DateTime @db.Date
  open      Float
  close     Float
  high      Float
  low       Float
  volume    Float
  amount    Float
  changePct Float    @map("change_pct")
  turnover  Float? // 换手率（筹码分布计算需要）

  @@unique([code, date])
  @@index([date])
  @@map("stock_daily")
}

// 分析信号（底部放量/顶部放量等）
model StockSignal {
  id     Int      @id @default(autoincrement())
  code   String   @db.VarChar(10)
  date   DateTime @db.Date
  type   String   @db.VarChar(30) // bottom_volume / top_volume
  detail String? // JSON：量比、位置分位等

  @@unique([code, date, type])
  @@index([date, type])
  @@map("stock_signal")
}

// 资讯快讯（定时抓取落库，codes 为关联到的股票代码）
model NewsFlash {
  id          Int      @id @default(autoincrement())
  source      String   @db.VarChar(20) // wallstcn / xuangubao
  externalId  String   @map("external_id") @db.VarChar(50)
  title       String?  @db.VarChar(500)
  content     String
  codes       String? // 匹配到的股票代码，逗号分隔
  publishedAt DateTime @map("published_at")

  @@unique([source, externalId])
  @@index([publishedAt])
  @@map("news_flash")
}

// 行情总览三排卡片缓存（indices 为全局 userId='*'，positions/watchlist 按用户隔离）
model OverviewCache {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  kind      String   @db.VarChar(20) // indices / positions / watchlist
  payload   String   @db.Text // JSON
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([userId, kind])
  @@map("overview_cache")
}

// 定时任务 cron 覆盖配置（仅被修改过的任务才有行，未覆盖时用代码注册表默认值）
model CronJob {
  id        String   @id // 对应 scheduler JOBS 注册表 id
  cron      String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("cron_job")
}

// 定时任务运行记录
model CronRun {
  id         Int       @id @default(autoincrement())
  jobId      String    @map("job_id") @db.VarChar(50)
  trigger    String    @db.VarChar(10) // auto / manual
  status     String    @db.VarChar(10) // running / success / failed
  message    String?   @db.Text
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamp(0)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(0)

  @@index([jobId, startedAt])
  @@map("cron_run")
}
